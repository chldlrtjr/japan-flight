# Telegram Bot Configuration for Flight Deal Notifications
# 1. @BotFather 에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=

# 2. @userinfobot 또는 @myidbot 에서 확인한 본인의 Chat ID (숫자)
TELEGRAM_CHAT_ID=

# 3. NAVER API HUB (console.ncloud.com) 에서 발급받은 Client ID / Client Secret
#    구독 필요: 검색(뉴스) / 검색어 트렌드(월 50,000건)
NAVER_API_KEY_ID=
NAVER_API_KEY=
